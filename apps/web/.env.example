# Where the Express API runs. The browser never calls it directly: Next proxies /api/* to it.
API_ORIGIN=http://localhost:4000

# Shows demo-only controls (e.g. "Generate demo attendance"). Leave unset in production.
NEXT_PUBLIC_DEMO=1

# Shown on the invite-expired page (no signed-in user yet, so it cannot come from the API).
NEXT_PUBLIC_COMPANY_PHONE=
