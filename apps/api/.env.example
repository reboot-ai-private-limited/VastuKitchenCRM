NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# MongoDB Atlas connection string (SRV). Atlas in every environment, including local dev.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vastu-dev?retryWrites=true&w=majority

# Comma-separated browser origins allowed to call the API (Next.js admin runs on :3001 locally).
CORS_ORIGINS=http://localhost:3001

# Access-token signing secret (>= 32 chars):  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
REFRESH_GRACE_SECONDS=10
CUSTOMER_REFRESH_TTL_DAYS=90
CUSTOMER_INVITE_TTL_DAYS=7
BCRYPT_COST=12

# Refresh cookie (web). Web app and API should share a registrable domain; otherwise use
# COOKIE_SAMESITE=none (requires HTTPS).
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=.example.com

# Where customer invite links point (the Next.js admin/portal).
WEB_BASE_URL=http://localhost:3001

# Reminder rules, in days (decimals ok: 0.001 is about a minute — useful for demos).
LEAD_STUCK_DAYS=2
REMINDER_UNSEEN_DAYS=2
REMINDER_NO_ACTION_DAYS=2
REMINDER_STAGNANT_MAX=3
REMINDER_COMPLAINT_DAYS=3
REMINDER_INTERVAL_MINUTES=60

# Run reminder cron jobs in this process. Keep true on exactly ONE instance.
ENABLE_CRON=true

# Photo and file storage (Cloudinary). Add your own values here; never commit them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# One folder per environment, so dev uploads never mix with production.
CLOUDINARY_FOLDER=vastu-dev

# WhatsApp through WA AGENT: login codes and proposal links. Leave the key blank in development:
# login codes then print in the API console and proposals fall back to a manual wa.me link.
# Check the setup with:  pnpm --filter @vastu/api check:whatsapp
WA_AGENT_API_KEY=
WA_AGENT_PHONE_NUMBER_ID=
# Login code template ("reboot_otp", AUTHENTICATION). Give its id (from "For the API"), or its name + language.
WA_AGENT_OTP_TEMPLATE_ID=6ae3593988c628420cfdea37
WA_AGENT_OTP_TEMPLATE=
WA_AGENT_OTP_LANGUAGE=en
# Proposal link template ("proposal_share", UTILITY): body.1 first name, body.2 proposal number,
# body.3 company name, button.0.1 the proposal token (the button URL ends in /p/{{1}}).
WA_AGENT_PROPOSAL_TEMPLATE_ID=6af5ab55e3f8b778d402aa63
WA_AGENT_PROPOSAL_TEMPLATE=
WA_AGENT_PROPOSAL_LANGUAGE=en
# Demo only: every login code is 123456 (refused in production).
OTP_DEV_MODE=false

# The business's timezone: a to-do "due on the 14th" is overdue when the 14th ends here.
BUSINESS_TIMEZONE=Asia/Kolkata

# Optional: only if enhanced push security is enabled in the Expo dashboard.
EXPO_ACCESS_TOKEN=

# --- Mobile app update policy (defaults of Settings > App; links are env-only) ---
# APP_ANDROID_MIN_VERSION=0.0.0
# APP_ANDROID_RECOMMENDED_VERSION=0.0.0
# APP_IOS_MIN_VERSION=0.0.0
# APP_IOS_RECOMMENDED_VERSION=0.0.0
APP_ANDROID_STORE_URL=
APP_ANDROID_APK_URL=
APP_IOS_STORE_URL=
# APP_POLL_UNREAD_SEC=60
# APP_POLL_CHAT_SEC=15
