{
  "name": "vastukitchencrm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@vastu/api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run typecheck lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
